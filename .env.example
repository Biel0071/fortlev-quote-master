# Frontend (configuração pública do Supabase próprio)
VITE_SUPABASE_URL="https://api.seudominio.com"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-publica"

# ---- Abaixo: SEGREDOS. Coloque somente em .env.local (ignorado pelo Git). NUNCA em .env.example preenchido. ----
